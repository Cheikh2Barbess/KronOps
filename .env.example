# Copie ce fichier en ".env" puis change les mots de passe.
# Ne mets JAMAIS le fichier .env dans Git (il est deja ignore).

# Superutilisateur PostgreSQL : sert UNIQUEMENT a la creation initiale des roles.
POSTGRES_PASSWORD=change-moi-super

DB_NAME=kronops
# Role proprietaire : joue les migrations.
DB_OWNER_USER=kronops_owner
DB_OWNER_PASSWORD=change-moi-owner
# Role applicatif : utilise par l'API, soumis a la Row-Level Security.
DB_APP_USER=kronops_app
DB_APP_PASSWORD=change-moi-app

# Developpement local uniquement. En production : DJANGO_DEBUG=0 et une vraie cle secrete.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-moi-cle-secrete-longue-et-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
